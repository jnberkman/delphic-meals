# Local development env for the Delphic meals server.
# Copy this file to server/.env and fill in only what you need.

# Required for local API/database testing.
# Prefer a local or dev database, not production.
DATABASE_URL=postgres://user:password@localhost:5432/delphic_meals

# Server
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Guest access code checked server-side.
# Use a local-only value here.
ACCESS_CODE=change-me-local-password

# Google OAuth client ID.
# Leave blank to use the default configured in src/config.js.
GOOGLE_CLIENT_ID=

# Google Sheets sync.
# Leave blank locally unless you intentionally want to write to a sheet.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SPREADSHEET_ID=

# Email.
# Leave blank locally unless you intentionally want to send emails.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Delphic Club <noreply@delphicclub.com>

# GroupMe bot.
# Leave blank locally unless you intentionally want to post/poll GroupMe.
GROUPME_BOT_ID=
GROUPME_ACCESS_TOKEN=
GROUPME_GROUP_ID=
GROUPME_CALLBACK_SECRET=
GROUPME_NICKNAME_MAP=
GROUPME_TOPIC_ID=
